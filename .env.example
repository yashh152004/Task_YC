# Environment Variables Example for Smart Loan Matcher

# AWS Credentials and Region
AWS_REGION=ap-south-1
AWS_ACCESS_KEY_ID=your_aws_access_key_id
AWS_SECRET_ACCESS_KEY=your_aws_secret_access_key
SES_SENDER_EMAIL=verified-sender@example.com

# PostgreSQL Database Configuration
DB_HOST=localhost
DB_PORT=5432
DB_NAME=loan_matcher_db
DB_USER=postgres
DB_PASSWORD=postgres123

# S3 Configuration
UPLOAD_BUCKET=loan-user-uploads-bucket-dev

# n8n Webhook Configuration
N8N_HOST=localhost
N8N_PORT=5678
N8N_WEBHOOK_URL=http://localhost:5678/webhook/new-users

# Optional: Google Gemini API Key for Stage 3 LLM Matching
GEMINI_API_KEY=your_gemini_api_key_here
